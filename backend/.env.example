# LLM Configuration
# LLM_PROVIDER can be "ollama" (local) or "groq" (cloud API)
LLM_PROVIDER=ollama

# Ollama Settings (for local LLM)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct

# Groq Settings (for high performance API - free at console.groq.com)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Gemini Settings (for high performance Embeddings - free at aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here

# Embeddings
EMBEDDINGS_MODEL=BAAI/bge-small-en

# Paths (optional overrides)
DATASET_DIR=../Resume_Dataset/data/INFORMATION-TECHNOLOGY

# OCR
OCR_ENABLED=true
OCR_LANGUAGE=eng

# API
ALLOW_ORIGINS=http://localhost:5173
